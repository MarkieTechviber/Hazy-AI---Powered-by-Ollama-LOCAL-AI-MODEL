# Canonical Node backend
HOST=127.0.0.1
PORT=8080
HAZY_MODEL=ollama/llama3.2:1b
HAZY_EMBEDDING_MODEL=embeddinggemma
HAZY_CONTEXT_SIZE=4096
HAZY_RAG_CHUNKS=6
HAZY_AGENT_MAX_STEPS=6

# Local services
OLLAMA_URL=http://127.0.0.1:11434
KOKORO_URL=http://127.0.0.1:8880/v1/audio/speech
HAZY_TTS=0

# Optional private data locations
# HAZY_DATA_DIR=C:/path/to/private/hazy-data
# HAZY_CONFIG_DIR=C:/path/to/private/hazy-config

# Keep network overrides disabled unless this is a trusted development setup.
# HAZY_BROWSER_ALLOW_LOCALHOST=0
# HAZY_BROWSER_ALLOW_PRIVATE_NETWORK=0
